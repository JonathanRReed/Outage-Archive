{
  "name": "internet-outage-atlas",
  "type": "module",
  "version": "1.0.0",
  "description": "An editorial broadsheet atlas documenting major internet outages, built with Astro and CloudCannon.",
  "keywords": ["astro", "cloudcannon", "editorial-design", "internet-outages", "broadsheet"],
  "license": "MIT",
  "author": {
    "name": "Jonathan R. Reed",
    "url": "https://jonathanrreed.com/about/"
  },
  "homepage": "https://outage-archive.jonathanrreed.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/JonathanRReed/Outage-Archive.git"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "DISABLE_COMPONENT_LIBRARY=true astro build",
    "build:with-library": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run lint && npm run format",
    "check:fix": "npm run lint:fix && npm run format:fix",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:yml",
    "lint:js": "eslint .",
    "lint:yml": "eslint \"**/*.{yml,yaml}\"",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix && npm run lint:yml:fix",
    "lint:js:fix": "eslint . --fix",
    "lint:yml:fix": "eslint \"**/*.{yml,yaml}\" --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "audit:shadscan:ui": "bunx @shadscan/cli@0.17.0 --check-ui https://outage-archive.jonathanrreed.com --no-interactive --no-roast"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/node": "^10.1.3",
    "@astrojs/sitemap": "^3.7.3",
    "@choctawnationofoklahoma/lite-vimeo": "^1.3.1",
    "@cloudcannon/editable-regions": "^0.0.12",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "@types/js-yaml": "^4.0.9",
    "astro": "^6.4.4",
    "astro-icon": "^1.1.5",
    "astro-seo": "^1.1.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "glob": "^13.0.6",
    "js-beautify": "^1.15.4",
    "js-yaml": "^4.2.0",
    "jszip": "^3.10.1",
    "lightningcss": "^1.32.0",
    "markdown-it": "^14.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.34.5",
    "shiki": "^4.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsonc": "^3.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-yml": "^3.4.0",
    "jsonc-eslint-parser": "^3.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "yaml-eslint-parser": "^2.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "^0.34.5",
    "@img/sharp-linuxmusl-x64": "^0.34.5",
    "@rollup/rollup-linux-x64-gnu": "^4.61.1",
    "@rollup/rollup-win32-x64-msvc": "^4.61.1"
  },
  "overrides": {
    "yaml": "^2.8.3",
    "brace-expansion": "^2.0.3"
  }
}
