---
import AtlasFooter from "@components/atlas/atlas-footer/AtlasFooter.astro";
import AtlasPageShell from "@components/atlas/shared/AtlasPageShell.astro";
import TimelineLedger from "@components/atlas/timeline-ledger/TimelineLedger.astro";
import { getAllTimelineIncidents } from "@data/atlasIncidents";
import Layout from "@layouts/BaseLayout.astro";

const incidents = getAllTimelineIncidents();
---

<Layout
  title="Internet Outage Atlas Timeline"
  description="Review the Internet Outage Atlas timeline by date, with each major infrastructure failure linked to its full case file and source context."
>
  <section
    class="atlas-page-surface"
    aria-label="Timeline surface"
  >
    <AtlasPageShell
      currentPage="timeline"
      dateline={`Vol. I · Complete Timeline · ${incidents.length} incidents indexed`}
      kicker="Internet Outage Atlas · Timeline"
      heading="FULL<br>TIMELINE"
      subtitle="A date-ordered view of the atlas, with every entry linked to its full case file"
    >
      <section class="timeline-page-lede">
        <div class="timeline-page-copy">
          <div class="timeline-page-byline">Timeline view</div>
          <h2 class="timeline-page-title">Incidents over time</h2>
          <p>
            Everything in the atlas, homepage incidents included, in one sequence. Scan it to see
            which dependencies kept failing, then open an entry for the full case file.
          </p>
        </div>
      </section>

      <TimelineLedger incidents={incidents} />

      <AtlasFooter
        publicationTitle="Internet<br>Outage Atlas"
        tagline="Chronological index of the atlas corpus with direct links into each case file"
        figures={[
          { bold: String(incidents.length), text: "Incidents indexed in the timeline" },
          { bold: "Archives", text: "Same incidents, grouped by failure mode" },
          { bold: "Map", text: "Same incidents, plotted by where they landed" },
        ]}
        editionText="Timeline Edition<br />Chronological record"
        copyrightText="© 2026 Jonathan R. Reed"
        typesetText="Sequenced and indexed for Internet Outage Atlas"
        websiteUrl="https://JonathanRReed.com"
        articleUrl="https://JonathanRReed.com/blog/days-the-internet-dies/"
      />
    </AtlasPageShell>
  </section>
</Layout>

<style>
  @layer page-sections {
    .timeline-page-lede {
      display: grid;
      gap: 1.5rem;
      padding: 2.2rem 3rem 2rem;
    }
    .timeline-page-byline {
      border-left: 2px solid var(--atlas-gold);
      color: var(--atlas-ink-muted);
      font-size: 10px;
      letter-spacing: 0.15em;
      margin-bottom: 1.1rem;
      padding-left: 1rem;
      text-transform: uppercase;
    }
    .timeline-page-title {
      color: var(--atlas-ink);
      font-family: var(--atlas-font-display);
      font-size: clamp(2rem, 3.4vw, 2.8rem);
      font-weight: 900;
      letter-spacing: -0.02em;
      line-height: 1.02;
      margin-bottom: 0.8rem;
    }
    .timeline-page-copy p {
      color: var(--atlas-ink-mid);
      font-size: 14px;
      line-height: 1.9;
      margin-bottom: 1rem;
      max-width: 64ch;
    }
    .timeline-page-copy p:last-child {
      margin-bottom: 0;
    }

    @media (max-width: 1080px) {
      .timeline-page-lede {
        grid-template-columns: 1fr;
        padding: 2rem 1.5rem 1.5rem;
      }
    }
  }
</style>
