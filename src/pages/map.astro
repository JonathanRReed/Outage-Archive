---
import AtlasFooter from "@components/atlas/atlas-footer/AtlasFooter.astro";
import AtlasPageShell from "@components/atlas/shared/AtlasPageShell.astro";
import { atlasIncidents, type AtlasIncident } from "@data/atlasIncidents";
import {
  WORLD_HEIGHT,
  WORLD_VIEWBOX,
  WORLD_WIDTH,
  projectEquirectangular,
  worldLandPath,
} from "@data/worldMapPath";
import Layout from "@layouts/BaseLayout.astro";

const round = (n: number) => Math.round(n * 10) / 10;

type Marker = { inc: AtlasIncident; x: number; y: number; place: string };

const impactMarkers: Marker[] = [];
const originMarkers: Marker[] = [];
const placed = new Set<string>();

for (const inc of atlasIncidents) {
  if (inc.geo && inc.geo.length) {
    placed.add(inc.slug);
    for (const pt of inc.geo) {
      const p = projectEquirectangular(pt.lng, pt.lat);

      impactMarkers.push({ inc, x: round(p.x), y: round(p.y), place: pt.label });
    }
  } else if (inc.originRegion) {
    placed.add(inc.slug);
    const p = projectEquirectangular(inc.originRegion.lng, inc.originRegion.lat);

    originMarkers.push({ inc, x: round(p.x), y: round(p.y), place: inc.originRegion.label });
  }
}

const chronological = [...atlasIncidents].sort((a, b) => a.sortDate.localeCompare(b.sortDate));
const chrono = chronological.map((inc) => ({
  slug: inc.slug,
  title: inc.title,
  date: inc.sortDate,
  dateLabel: inc.dateLabel,
  category: inc.category,
  rank: inc.severityRank ?? 2,
  placed: placed.has(inc.slug),
}));

const worldwide = atlasIncidents
  .filter((inc) => !placed.has(inc.slug))
  .sort((a, b) => a.sortDate.localeCompare(b.sortDate));

const minDate = chrono[0].date;
const maxDate = chrono[chrono.length - 1].date;
const minT = Date.parse(minDate);
const maxT = Date.parse(maxDate);
const axisTicks = [2000, 2005, 2010, 2015, 2020, 2025]
  .map((y) => ({ y, pct: round(((Date.parse(`${y}-01-01`) - minT) / (maxT - minT)) * 100) }))
  .filter((t) => t.pct >= 0 && t.pct <= 100);

const meridians: number[] = [];

for (let lng = -150; lng <= 150; lng += 30) meridians.push(round(projectEquirectangular(lng, 0).x));
const parallels: number[] = [];

for (let lat = -60; lat <= 60; lat += 30) parallels.push(round(projectEquirectangular(0, lat).y));

const sevClass = (rank?: 1 | 2 | 3) =>
  rank === 3 ? "is-critical" : rank === 1 ? "is-low" : "is-high";
// Severity drives the marker: bigger core + more concentric "blast" rings = wider blast radius.
const coreR = (rank?: 1 | 2 | 3) => (rank === 3 ? 6.4 : rank === 2 ? 4.8 : 3.6);
const ringCount = (rank?: 1 | 2 | 3) => (rank === 3 ? 2 : rank === 2 ? 1 : 0);
const services = (inc: AtlasIncident) =>
  (inc.affectedServices ?? [])
    .map((s) => s.name)
    .slice(0, 5)
    .join(" · ");

// --- Reach / area of effect ---
// Coarse continent ellipses (equirectangular viewBox coords) that light up to show
// how far an outage reached. Global incidents light the whole world.
const REGIONS = {
  na: { cx: 240, cy: 135, rx: 120, ry: 88 },
  sa: { cx: 332, cy: 322, rx: 70, ry: 108 },
  eu: { cx: 542, cy: 112, rx: 78, ry: 56 },
  me: { cx: 628, cy: 188, rx: 52, ry: 48 },
  af: { cx: 548, cy: 255, rx: 96, ry: 112 },
  as: { cx: 770, cy: 158, rx: 162, ry: 110 },
  oc: { cx: 868, cy: 322, rx: 96, ry: 70 },
} as const;

type RegionKey = keyof typeof REGIONS;
const ALL_REGIONS = Object.keys(REGIONS) as RegionKey[];

function regionOf(lat: number, lng: number): RegionKey {
  if (lng >= -82 && lng <= -34 && lat >= -56 && lat <= 14) return "sa";
  if (lng >= -170 && lng <= -50 && lat >= 7 && lat <= 75) return "na";
  if (lng >= 33 && lng <= 63 && lat >= 12 && lat <= 43) return "me";
  if (lng >= -25 && lng <= 45 && lat >= 34 && lat <= 72) return "eu";
  if (lng >= -20 && lng <= 52 && lat >= -36 && lat <= 37) return "af";
  if (lng >= 110 && lng <= 180 && lat >= -50 && lat <= 0) return "oc";
  if (lng >= 60 && lng <= 180 && lat >= 5 && lat <= 78) return "as";
  return "na";
}

type Reach = { score: number; regions: string; text: string };
function reachOf(inc: AtlasIncident): Reach {
  const svc = inc.affectedServices?.length ?? 0;
  const dur = inc.durationMinutes ?? 0;
  let s = inc.scope === "global" ? 3 : inc.scope === "regional" ? 2 : 1;

  s += Math.min(1.5, svc / 6);
  s += dur >= 1440 ? 1 : dur >= 360 ? 0.5 : 0;
  s += inc.severityRank === 3 ? 0.5 : 0;
  const score = Math.max(1, Math.min(5, Math.round(s)));

  let regions: RegionKey[];

  if (inc.scope === "global") regions = ALL_REGIONS;
  else if (inc.geo && inc.geo.length)
    regions = [...new Set(inc.geo.map((p) => regionOf(p.lat, p.lng)))];
  else if (inc.originRegion) regions = [regionOf(inc.originRegion.lat, inc.originRegion.lng)];
  else regions = ALL_REGIONS;

  const reachWord =
    inc.scope === "global" ? "Worldwide" : inc.scope === "regional" ? "Regional" : "Local";
  const durTxt =
    dur >= 1440
      ? `~${Math.round(dur / 1440)}-day recovery`
      : dur >= 60
        ? `~${Math.round(dur / 60)}h`
        : dur
          ? `${dur}m`
          : "";
  const text = [`${reachWord} reach`, svc ? `${svc} services` : "", durTxt]
    .filter(Boolean)
    .join(" · ");

  return { score, regions: regions.join(" "), text };
}

// Fan co-located markers (e.g. the AWS us-east-1 stack) onto a small ring so each
// stays individually hoverable instead of hiding under the top one.
function declutterMarkers(all: Marker[]): void {
  const buckets = new Map<string, Marker[]>();

  for (const m of all) {
    const key = `${Math.round(m.x)},${Math.round(m.y)}`;
    const arr = buckets.get(key);

    if (arr) arr.push(m);
    else buckets.set(key, [m]);
  }
  for (const group of buckets.values()) {
    if (group.length < 2) continue;
    const n = group.length;
    const radius = 2.6 + n * 0.7;

    group.forEach((m, i) => {
      const angle = (i / n) * Math.PI * 2 - Math.PI / 2;

      m.x = round(m.x + Math.cos(angle) * radius);
      m.y = round(m.y + Math.sin(angle) * radius);
    });
  }
}
declutterMarkers([...impactMarkers, ...originMarkers]);

const reachPips = (score: number) => Array.from({ length: 5 }, (_, i) => i < score);
---

<Layout
  title="The Atlas Map"
  description="An engraved, playable world map of where major internet outages struck — scrub through 1997 to 2026 and watch the failures ripple onto the map."
>
  <section
    class="atlas-page-surface"
    aria-label="Atlas map surface"
  >
    <AtlasPageShell
      currentPage="map"
      dateline={`Vol. I · Cartography · ${placed.size} located, ${worldwide.length} worldwide`}
      kicker="Internet Outage Atlas · The Map"
      heading="THE<br>ATLAS MAP"
      subtitle="Press play to watch a quarter-century of outages ripple across the world"
    >
      <section class="map-section">
        <div class="map-lede">
          <p>
            Press <strong>Play the record</strong> to sweep from 1997 to today and watch each outage strike
            in order, or drag the dial to any year. Solid marks are incidents tied to a place; hollow
            marks are fault origins for failures whose impact still spread worldwide. The incidents in
            the <a href="#worldwide-ledger">Worldwide Ledger</a> struck everywhere at once and resist
            a single dot.
          </p>
        </div>

        <div class="map-frame">
          <svg
            viewBox={WORLD_VIEWBOX}
            class="world-map"
            id="atlasMap"
            role="img"
            aria-label="Equirectangular world map with markers for outage-affected regions"
            preserveAspectRatio="xMidYMid meet"
          >
            <rect
              x="0"
              y="0"
              width={WORLD_WIDTH}
              height={WORLD_HEIGHT}
              class="map-ocean"
            ></rect>
            <g class="map-graticule">
              {
                meridians.map((x) => (
                  <line
                    x1={x}
                    y1="0"
                    x2={x}
                    y2={WORLD_HEIGHT}
                  />
                ))
              }
              {
                parallels.map((y) => (
                  <line
                    x1="0"
                    y1={y}
                    x2={WORLD_WIDTH}
                    y2={y}
                  />
                ))
              }
            </g>
            <defs>
              <filter
                id="regionBlur"
                x="-20%"
                y="-20%"
                width="140%"
                height="140%"
              >
                <feGaussianBlur stdDeviation="7"></feGaussianBlur>
              </filter>
            </defs>
            <g
              class="region-glows"
              filter="url(#regionBlur)"
              aria-hidden="true"
            >
              {
                ALL_REGIONS.map((key) => (
                  <ellipse
                    class:list={["region-glow", `region-${key}`]}
                    cx={REGIONS[key].cx}
                    cy={REGIONS[key].cy}
                    rx={REGIONS[key].rx}
                    ry={REGIONS[key].ry}
                  />
                ))
              }
            </g>

            <path
              d={worldLandPath}
              class="map-land"
              fill-rule="evenodd"
            ></path>

            <g class="map-markers">
              {
                originMarkers.map((m) => {
                  const r = coreR(m.inc.severityRank);
                  const reach = reachOf(m.inc);

                  return (
                    <a
                      href={`/incident/${m.inc.slug}/`}
                      class="map-marker is-origin"
                      data-slug={m.inc.slug}
                      data-regions={reach.regions}
                      data-reach={String(reach.score)}
                      data-reach-text={reach.text}
                      data-date={m.inc.sortDate}
                      data-title={m.inc.title}
                      data-meta={`Fault origin · ${m.place} · ${m.inc.dateLabel}`}
                      data-services={services(m.inc)}
                    >
                      {m.inc.severityRank === 3 && (
                        <circle
                          class="map-ring map-ring-1 is-dashed"
                          cx={m.x}
                          cy={m.y}
                          r={r + 5}
                        />
                      )}
                      <circle
                        class="map-ripple"
                        cx={m.x}
                        cy={m.y}
                        r={r}
                      />
                      <circle
                        class="map-core"
                        cx={m.x}
                        cy={m.y}
                        r={r}
                      />
                      <circle
                        class="map-hit"
                        cx={m.x}
                        cy={m.y}
                        r={Math.max(r + 9, 12)}
                      />
                      <title>
                        {m.inc.title} — fault origin: {m.place} ({m.inc.dateLabel})
                      </title>
                    </a>
                  );
                })
              }
              {
                impactMarkers.map((m) => {
                  const r = coreR(m.inc.severityRank);
                  const rings = ringCount(m.inc.severityRank);
                  const reach = reachOf(m.inc);

                  return (
                    <a
                      href={`/incident/${m.inc.slug}/`}
                      class:list={["map-marker", sevClass(m.inc.severityRank)]}
                      data-slug={m.inc.slug}
                      data-regions={reach.regions}
                      data-reach={String(reach.score)}
                      data-reach-text={reach.text}
                      data-date={m.inc.sortDate}
                      data-title={m.inc.title}
                      data-meta={`${m.place} · ${m.inc.dateLabel}`}
                      data-services={services(m.inc)}
                    >
                      {rings >= 2 && (
                        <circle
                          class="map-ring map-ring-2"
                          cx={m.x}
                          cy={m.y}
                          r={r + 10}
                        />
                      )}
                      {rings >= 1 && (
                        <circle
                          class="map-ring map-ring-1"
                          cx={m.x}
                          cy={m.y}
                          r={r + 5}
                        />
                      )}
                      <circle
                        class="map-ripple"
                        cx={m.x}
                        cy={m.y}
                        r={r}
                      />
                      <circle
                        class="map-core"
                        cx={m.x}
                        cy={m.y}
                        r={r}
                      />
                      <circle
                        class="map-hit"
                        cx={m.x}
                        cy={m.y}
                        r={Math.max(r + 11, 13)}
                      />
                      <title>
                        {m.inc.title} — {m.place} ({m.inc.dateLabel})
                      </title>
                    </a>
                  );
                })
              }
            </g>
          </svg>

          <div
            class="map-tooltip"
            id="mapTooltip"
            hidden
          >
            <div
              class="map-tooltip-title"
              data-tip-title
            >
            </div>
            <div
              class="map-tooltip-meta"
              data-tip-meta
            >
            </div>
            <div class="map-tooltip-reach">
              <span
                class="reach-meter"
                data-tip-meter
              >
                <span class="reach-pip"></span>
                <span class="reach-pip"></span>
                <span class="reach-pip"></span>
                <span class="reach-pip"></span>
                <span class="reach-pip"></span>
              </span>
              <span
                class="reach-text"
                data-tip-reach-text
              ></span>
            </div>
            <div
              class="map-tooltip-services"
              data-tip-services
            >
            </div>
          </div>
        </div>

        <div
          class="map-timeline"
          data-min={minDate}
          data-max={maxDate}
        >
          <div class="map-timeline-head">
            <button
              type="button"
              class="map-play"
              id="mapPlay"
              aria-label="Play the outage timeline"
            >
              <span
                class="map-play-icon"
                id="mapPlayIcon"
                aria-hidden="true"
                >▶</span
              >
              <span id="mapPlayLabel">Play the record</span>
            </button>
            <div class="map-readout">
              <span
                class="map-year"
                id="mapYear"
                >{maxDate.slice(0, 4)}</span
              >
              <span
                class="map-dispatch"
                id="mapDispatch"
                aria-live="polite"
                >All incidents shown — drag the dial or press play</span
              >
            </div>
          </div>
          <div class="map-scrubber-wrap">
            <input
              type="range"
              class="map-scrubber"
              id="mapScrubber"
              min="0"
              max="1000"
              value="1000"
              step="1"
              aria-label="Scrub through the outage timeline by date"
            />
            <div
              class="map-axis"
              aria-hidden="true"
            >
              {
                axisTicks.map((t) => (
                  <span
                    class="map-axis-tick"
                    style={`left:${t.pct}%`}
                  >
                    {t.y}
                  </span>
                ))
              }
            </div>
          </div>
        </div>

        <script
          type="application/json"
          id="mapChrono"
          is:inline
          set:html={JSON.stringify(chrono)}
        />

        <div
          class="map-legend"
          aria-hidden="true"
        >
          <span class="map-legend-item"><span class="map-dot is-critical"></span>Critical</span>
          <span class="map-legend-item"><span class="map-dot is-high"></span>High</span>
          <span class="map-legend-item"><span class="map-dot is-low"></span>Lower</span>
          <span class="map-legend-item"
            ><span class="map-dot is-origin"></span>Fault origin (global reach)</span
          >
        </div>

        <aside
          class="map-ledger"
          id="worldwide-ledger"
        >
          <div class="map-ledger-head">
            <div class="map-ledger-label">Worldwide Ledger</div>
            <h2 class="map-ledger-title">Incidents without a map</h2>
            <p class="map-ledger-intro">
              Failures in shared layers — DNS, BGP, CDNs, certificate trust, global control planes —
              that struck everywhere at once. There is no single place to mark, so they are filed
              here as dispatches.
            </p>
          </div>
          <ul class="map-ledger-list">
            {
              worldwide.map((inc) => {
                const reach = reachOf(inc);

                return (
                  <li>
                    <a
                      href={`/incident/${inc.slug}/`}
                      class="map-ledger-link"
                      data-slug={inc.slug}
                      data-regions={reach.regions}
                      data-reach={String(reach.score)}
                    >
                      <span class="map-ledger-main">
                        <span class="map-ledger-year">{inc.year}</span>
                        <span class="map-ledger-name">{inc.title}</span>
                        <span class="map-ledger-cat">{inc.category}</span>
                      </span>
                      <span class="map-ledger-reach">
                        <span
                          class="reach-meter"
                          aria-hidden="true"
                        >
                          {reachPips(reach.score).map((on) => (
                            <span class:list={["reach-pip", on && "is-on"]} />
                          ))}
                        </span>
                        <span class="reach-text">{reach.text}</span>
                      </span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </aside>

        <AtlasFooter
          publicationTitle="Internet<br>Outage Atlas"
          tagline="An engraved chart of where shared-infrastructure failures touched the ground."
          figures={[
            {
              bold: String(placed.size),
              text: "Incidents located on the map",
            },
            { bold: String(worldwide.length), text: "Filed in the Worldwide Ledger" },
            { bold: String(atlasIncidents.length), text: "Incidents in the atlas" },
          ]}
          editionText="Cartographic Edition<br />Equirectangular projection"
          copyrightText="© 2026 Internet Outage Atlas Project. All content for educational purposes."
          typesetText="Land outline: Natural Earth (public domain)"
          websiteUrl="https://JonathanRReed.com"
          articleUrl="https://JonathanRReed.com/blog/days-the-internet-dies/"
        />
      </section>
    </AtlasPageShell>
  </section>
</Layout>

<script is:inline>
  (function () {
    function initMap() {
      var map = document.getElementById("atlasMap");
      var chronoEl = document.getElementById("mapChrono");
      var tl = document.querySelector(".map-timeline");
      var scrubber = document.getElementById("mapScrubber");
      var yearEl = document.getElementById("mapYear");
      var dispatchEl = document.getElementById("mapDispatch");
      var playBtn = document.getElementById("mapPlay");
      var playIcon = document.getElementById("mapPlayIcon");
      var playLabel = document.getElementById("mapPlayLabel");
      var tip = document.getElementById("mapTooltip");
      var frame = document.querySelector(".map-frame");
      if (!map || !chronoEl || !scrubber || !tl) return;

      // Activate timeline-controlled visibility only once JS is alive, so the
      // map degrades to all-markers-visible if this script never runs.
      map.classList.add("is-timed");

      var chrono = JSON.parse(chronoEl.textContent || "[]");
      var minT = Date.parse(tl.getAttribute("data-min"));
      var maxT = Date.parse(tl.getAttribute("data-max"));
      var span = maxT - minT || 1;
      var reduce =
        window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      var markers = {};
      var onState = {};
      Array.prototype.forEach.call(map.querySelectorAll(".map-marker"), function (m) {
        var slug = m.getAttribute("data-slug");
        if (!markers[slug]) markers[slug] = [];
        markers[slug].push(m);
        m.classList.add("is-on");
        onState[slug] = true;
      });

      function timeFromValue(v) {
        return minT + (v / 1000) * span;
      }

      function render(t, animate) {
        yearEl.textContent = new Date(t).getUTCFullYear();
        var latest = null;
        for (var i = 0; i < chrono.length; i++) {
          var inc = chrono[i];
          var on = Date.parse(inc.date) <= t;
          if (on) latest = inc;
          if (onState[inc.slug] !== on) {
            onState[inc.slug] = on;
            var els = markers[inc.slug] || [];
            for (var j = 0; j < els.length; j++) {
              els[j].classList.toggle("is-on", on);
              if (on && animate && !reduce) {
                (function (el) {
                  el.classList.remove("rippling");
                  void el.getBBox();
                  el.classList.add("rippling");
                  setTimeout(function () {
                    el.classList.remove("rippling");
                  }, 950);
                })(els[j]);
              }
            }
          }
        }
        dispatchEl.textContent = latest
          ? latest.dateLabel + " — " + latest.title
          : "Before the record begins";
      }

      render(maxT, false);

      scrubber.addEventListener("input", function () {
        stop();
        render(timeFromValue(parseInt(scrubber.value, 10)), false);
      });

      var raf = null;
      var startStamp = 0;
      var startValue = 0;
      var DURATION = 17000;

      function step(ts) {
        if (!startStamp) startStamp = ts;
        var v = startValue + ((ts - startStamp) / DURATION) * (1000 - startValue);
        if (v >= 1000) {
          scrubber.value = "1000";
          render(maxT, true);
          stop();
          return;
        }
        scrubber.value = String(Math.round(v));
        render(timeFromValue(v), true);
        raf = requestAnimationFrame(step);
      }

      function play() {
        if (reduce) {
          scrubber.value = "1000";
          render(maxT, false);
          return;
        }
        var cur = parseInt(scrubber.value, 10);
        if (cur >= 1000) {
          cur = 0;
          scrubber.value = "0";
          render(minT, false);
        }
        startStamp = 0;
        startValue = cur;
        playBtn.classList.add("is-playing");
        playIcon.textContent = "❚❚";
        playLabel.textContent = "Pause";
        dispatchEl.setAttribute("aria-live", "off");
        raf = requestAnimationFrame(step);
      }

      function stop() {
        if (raf) cancelAnimationFrame(raf);
        raf = null;
        playBtn.classList.remove("is-playing");
        playIcon.textContent = "▶";
        playLabel.textContent = "Play the record";
        dispatchEl.setAttribute("aria-live", "polite");
      }

      playBtn.addEventListener("click", function () {
        if (raf) stop();
        else play();
      });

      // region glow — light up an incident's area of effect
      var regionEls = {};
      Array.prototype.forEach.call(map.querySelectorAll(".region-glow"), function (e) {
        var mtch = (e.getAttribute("class") || "").match(/region-([a-z]{2})\b/);
        if (mtch) regionEls[mtch[1]] = e;
      });
      function clearGlow() {
        map.removeAttribute("data-glow");
        for (var k in regionEls) {
          if (regionEls[k]) regionEls[k].classList.remove("is-glowing");
        }
      }
      function setGlow(el) {
        clearGlow();
        if (!el) return;
        var sev = el.classList.contains("is-critical")
          ? "critical"
          : el.classList.contains("is-high")
            ? "high"
            : el.classList.contains("is-low")
              ? "low"
              : "";
        if (!sev) {
          var rc = parseInt(el.getAttribute("data-reach") || "3", 10);
          sev = rc >= 4 ? "critical" : rc >= 3 ? "high" : "low";
        }
        map.setAttribute("data-glow", sev);
        var regions = (el.getAttribute("data-regions") || "").split(" ");
        for (var i = 0; i < regions.length; i++) {
          if (regionEls[regions[i]]) regionEls[regions[i]].classList.add("is-glowing");
        }
      }

      if (tip && frame) {
        var tTitle = tip.querySelector("[data-tip-title]");
        var tMeta = tip.querySelector("[data-tip-meta]");
        var tServices = tip.querySelector("[data-tip-services]");
        var tMeter = tip.querySelector("[data-tip-meter]");
        var tReachText = tip.querySelector("[data-tip-reach-text]");
        var show = function (marker) {
          tTitle.textContent = marker.getAttribute("data-title") || "";
          tMeta.textContent = marker.getAttribute("data-meta") || "";
          var svc = marker.getAttribute("data-services") || "";
          tServices.textContent = svc;
          tServices.style.display = svc ? "block" : "none";
          var score = parseInt(marker.getAttribute("data-reach") || "0", 10);
          if (tMeter) {
            var pips = tMeter.querySelectorAll(".reach-pip");
            for (var p = 0; p < pips.length; p++) pips[p].classList.toggle("is-on", p < score);
          }
          if (tReachText) tReachText.textContent = marker.getAttribute("data-reach-text") || "";
          var r = marker.getBoundingClientRect();
          var fr = frame.getBoundingClientRect();
          tip.style.left = r.left + r.width / 2 - fr.left + "px";
          tip.style.top = r.top - fr.top + "px";
          tip.hidden = false;
          tip.classList.toggle("is-below", r.top - fr.top < tip.offsetHeight + 16);
        };
        var hide = function () {
          tip.hidden = true;
        };
        Array.prototype.forEach.call(map.querySelectorAll(".map-marker"), function (marker) {
          marker.addEventListener("mouseenter", function () {
            show(marker);
            setGlow(marker);
          });
          marker.addEventListener("mouseleave", function () {
            hide();
            clearGlow();
          });
          marker.addEventListener("focus", function () {
            show(marker);
            setGlow(marker);
          });
          marker.addEventListener("blur", function () {
            hide();
            clearGlow();
          });
        });
      }

      // Worldwide Ledger rows light up their area of effect on the map
      Array.prototype.forEach.call(document.querySelectorAll(".map-ledger-link"), function (row) {
        row.addEventListener("mouseenter", function () {
          setGlow(row);
        });
        row.addEventListener("mouseleave", clearGlow);
        row.addEventListener("focus", function () {
          setGlow(row);
        });
        row.addEventListener("blur", clearGlow);
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initMap, { once: true });
    } else {
      initMap();
    }
  })();
</script>

