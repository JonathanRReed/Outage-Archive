---
import Footer from "@components/navigation/footer/Footer.astro";
import MainNavigation from "@components/navigation/main-nav/MainNav.astro";
import MainComponent from "@components/utils/MainComponent.astro";
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import Layout from "@layouts/BaseLayout.astro";

import type { ContentBlock } from "../types";

type Props = {
  frontmatter?: {
    title: string;
    description?: string;
    keywords?: string[];
    image?: string;
    canonical?: string;
    noindex?: boolean;
    seoSupportText?: string;
    pageSections?: ContentBlock[];
  };
  title?: string;
  description?: string;
  keywords?: string[];
  image?: string;
  canonical?: string;
  noindex?: boolean;
  mainNav?: Record<string, unknown>;
  footer?: Record<string, unknown>;
};

const {
  frontmatter,
  title: titleProp,
  description: descriptionProp,
  keywords: keywordsProp,
  image: imageProp,
  canonical: canonicalProp,
  mainNav = mainNavData,
  footer = footerData,
} = Astro.props as Props;

const title = frontmatter?.title ?? titleProp ?? "";
const description = frontmatter?.description ?? descriptionProp;
const keywords = frontmatter?.keywords ?? keywordsProp;
const image = frontmatter?.image ?? imageProp;
const canonical = frontmatter?.canonical ?? canonicalProp;
const noindex = frontmatter?.noindex ?? false;
const seoSupportText = frontmatter?.seoSupportText;
const sections = frontmatter?.pageSections ?? [];
const isAtlasPage = sections.some((section) => section._component.startsWith("atlas/"));
const editingEnabled = process.env.DISABLE_COMPONENT_LIBRARY !== "true";
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  image={image}
  canonical={canonical}
  noindex={noindex}
>
  {!isAtlasPage && <MainNavigation {...mainNav} />}

  {
    isAtlasPage ? (
      <section
        class="atlas-page-surface"
        aria-label="Internet Outage Atlas"
      >
        {sections.length > 0 && (
          <div
            data-editable={editingEnabled ? "component" : undefined}
            data-component={editingEnabled ? "utils/main-component" : undefined}
            data-prop-sections={editingEnabled ? "pageSections" : undefined}
          >
            <MainComponent sections={sections} />
          </div>
        )}
        <slot />
        {seoSupportText && <p class="seo-support-copy">{seoSupportText}</p>}
      </section>
    ) : (
      <main>
        {sections.length > 0 && (
          <div
            data-editable={editingEnabled ? "component" : undefined}
            data-component={editingEnabled ? "utils/main-component" : undefined}
            data-prop-sections={editingEnabled ? "pageSections" : undefined}
          >
            <MainComponent sections={sections} />
          </div>
        )}
        <slot />
        {seoSupportText && <p class="seo-support-copy">{seoSupportText}</p>}
      </main>
    )
  }
  {!isAtlasPage && <Footer {...footer} />}
</Layout>

<style>
  .seo-support-copy {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
